#!/usr/bin/env python3
# Claude Code 的 hook：只记录，不做任何决定（不输出、总是 exit 0），选择框照常弹出。
# Notification：把事件追加到 cc-crew/data/events.jsonl，由守护进程决定发不发。
# PermissionRequest：弹出选择框（选择题 / 要权限）前，把题目或要执行的命令记到 data/asks/<会话>.json，
#   因为对话记录要等你答完才写进去，飞书卡片靠它显示问的是什么。
# 只用标准库、不联网、出任何错都静默退出，不影响 claude。
import json, os, re, sys, time
DATA = os.environ.get("CLAUDE_MONITOR_DATA") or os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "data")
try:
    ev = json.load(sys.stdin)
    if ev.get("hook_event_name") == "PermissionRequest":
        sid = str(ev.get("session_id", ""))
        if re.fullmatch(r"[0-9a-fA-F-]{8,64}", sid):
            keep = {k: ev.get(k) for k in ("session_id", "tool_name", "tool_input", "tool_use_id")}
            keep["t"] = time.time()
            os.makedirs(f"{DATA}/asks", exist_ok=True)
            path = f"{DATA}/asks/{sid}.json"
            with open(path + ".tmp", "w", encoding="utf-8") as f:
                json.dump(keep, f, ensure_ascii=False)
            os.replace(path + ".tmp", path)
    else:
        keep = {k: ev.get(k) for k in ("session_id", "cwd", "hook_event_name", "message", "notification_type")}
        keep["t"] = time.time()
        with open(f"{DATA}/events.jsonl", "a", encoding="utf-8") as f:
            f.write(json.dumps(keep, ensure_ascii=False) + "\n")
except Exception:
    pass
sys.exit(0)
